# PaletteLab Environment Variables
# No external AI keys required — all palette generation is local math (zero cost).
# Add only when you enable monetization analytics.

# APP_URL: Your deployed URL (e.g. https://palettelab.app)
APP_URL="http://localhost:3000"

# === Google AdSense (required for ads to serve) ===
# Your publisher ID from AdSense dashboard (Settings → Account → Publisher ID)
VITE_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"

# Ad unit slot IDs — create each in AdSense → Ads → By ad unit → New ad unit
# then paste the numeric ID here. Without real slot IDs, ads will NOT serve.
VITE_ADSENSE_SLOT_NATIVE=""    # In-feed native ad (between palette cards)
VITE_ADSENSE_SLOT_SIDEBAR=""   # Sidebar rectangle 300×250 (palette detail / tools)
VITE_ADSENSE_SLOT_BANNER=""    # Responsive banner (below hero / between sections)

# Optional: Enable Google Auto-ads (lets Google auto-place ads, no manual slots needed)
# Set to "1" to enable — Google will auto-detect ad placements on each page.
VITE_ADSENSE_AUTO_ADS=""       # Set to "1" for auto-ads mode

# === Analytics (optional, but recommended for revenue optimization) ===
# GA4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=""
# Microsoft Clarity (e.g. abc123)
VITE_CLARITY_ID=""

# Legacy server vars still supported:
# GA_MEASUREMENT_ID="G-PLACEHOLDER"
# ADSENSE_CLIENT="ca-pub-PLACEHOLDER"
