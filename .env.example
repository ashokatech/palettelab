# PaletteLab Environment Variables
# No external AI keys required — all palette generation is local math (zero cost).
# Add only when you enable monetization analytics.

# APP_URL: Your deployed URL (e.g. https://palettelab.app)
APP_URL="http://localhost:3000"

# OPTIONAL: Add only after you create accounts
# GA4 Measurement ID (e.g. G-XXXXXXXXXX) -> use VITE_GA_MEASUREMENT_ID for client
# VITE_GA_MEASUREMENT_ID="G-PLACEHOLDER"
# Microsoft Clarity (e.g. abc123)
# VITE_CLARITY_ID="PLACEHOLDER"
# Google AdSense Publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX) -> use VITE_ADSENSE_CLIENT
# VITE_ADSENSE_CLIENT="ca-pub-PLACEHOLDER"
# Legacy server var still supported:
# GA_MEASUREMENT_ID="G-PLACEHOLDER"
# ADSENSE_CLIENT="ca-pub-PLACEHOLDER"
